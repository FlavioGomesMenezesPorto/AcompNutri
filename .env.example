# ---------- Frontend (site e app) ----------
# Copie para .env.local e preencha.

# Supabase → Project Settings → API. É usado SÓ para o login com Google.
# As duas são públicas por natureza. NUNCA coloque aqui a service_role / secret key.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx

# Endereço público da API (pasta server/).
# Site: deixe vazio se o site e a API ficam no mesmo domínio (ou em desenvolvimento,
#       onde o Vite repassa /api para http://localhost:3000).
# App Android: use o arquivo .env.android (veja .env.android.example).
VITE_API_URL=

# Copie para .env.android — usado por "npm run android:build".
# O app Android precisa do endereço completo da API (não existe "mesmo domínio" no celular).
# Use HTTPS (ex.: a API publicada no Render/Railway).
VITE_API_URL=https://api.seudominio.com

# Só para testar com a API rodando no seu PC pela rede de casa (sem HTTPS):
# VITE_API_URL=http://192.168.0.10:3000
# e gere o APK com:  set CAP_ALLOW_HTTP=true  (PowerShell: $env:CAP_ALLOW_HTTP="true")

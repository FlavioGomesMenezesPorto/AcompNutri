{
  "name": "acompnutri-server",
  "version": "1.0.0",
  "private": true,
  "description": "API do AcompNutri (Express + PostgreSQL). O Supabase é usado só para o login.",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:local": "node dev-db.js",
    "dev:local": "node --watch --env-file-if-exists=.env.local-db index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0"
  }
}

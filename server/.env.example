# ---------- API do AcompNutri ----------
# Copie para server/.env e preencha.

PORT=3000

# Banco PostgreSQL da API (os dados ficam aqui, não no Supabase).
# Local com Docker (docker compose up -d db):
DATABASE_URL=postgres://acompnutri:troque-esta-senha@localhost:5434/acompnutri
# true para bancos gerenciados que exigem SSL (Neon, Render, Railway…)
DATABASE_SSL=false

# Supabase — usado SÓ para validar o login (o token que o app envia).
# Mesmo "Project URL" do frontend. A API baixa as chaves públicas sozinha.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Opcional: só se o projeto ainda usar o "Legacy JWT secret" (HS256).
# Project Settings → JWT Keys → Legacy JWT Secret. É secreto: nunca no frontend.
SUPABASE_JWT_SECRET=

# Origens que podem chamar a API (separadas por vírgula). Vazio = qualquer uma.
# Em produção: o domínio do site + https://localhost (o app Android).
CORS_ORIGIN=
APP_TIMEZONE=America/Sao_Paulo
